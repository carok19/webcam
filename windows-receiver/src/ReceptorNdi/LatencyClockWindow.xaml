<Window x:Class="ReceptorNdi.LatencyClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reloj para medir latencia" Width="900" Height="420" Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Viewbox Margin="20">
            <TextBlock x:Name="ClockText" Text="00:00.000" FontFamily="Consolas" Foreground="White" FontWeight="Bold"/>
        </Viewbox>
        <TextBlock Grid.Row="1" Margin="16" Foreground="#9AA0A6" TextWrapping="Wrap" FontSize="13"
                   Text="Apunta la cámara del celular a este reloj y pon la fuente NDI de OBS al lado (o en otra pantalla). Toma una captura de pantalla (Win+Shift+S): la diferencia entre el reloj real y el que se ve en OBS es la latencia total (cristal a cristal). Repite 5 veces y promedia."/>
    </Grid>
</Window>
